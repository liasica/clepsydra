VITE_BASE=/

# 接口地址（8 个 api 模块已硬编码 /api/xxx 前缀，这里保持 / 避免拼成 /api/api/xxx）
VITE_GLOB_API_URL=/

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式，Go 后端已按 history 模式配置 fallback
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip（关闭，避免被 Go 侧 embed 一起打进二进制）
VITE_ARCHIVER=false
